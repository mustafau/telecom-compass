# Copy to .env.local for local development. Do not put real secrets in git.
# Empty MODEL_*/OIDC_* values are intentional placeholders.
APP_MODE=local
AUTH_MODE=local-fixture
MODEL_MODE=scripted
APP_ORIGIN=http://localhost:3000
PORT=3000
# Local Compose default only — not a production credential.
DATABASE_URL=postgresql://compass:local_only@127.0.0.1:5432/compass
DEPLOYMENTS_FILE=./config/deployments.local.yaml
DEFAULT_DEPLOYMENT_ID=telecom-api-sandbox
# Used by pnpm setup:local (and loaded from .env.local). Not read at turn runtime —
# runtime uses baseUrl values written into config/deployments.local.yaml.
# On macOS <13.5 use the hosted preview or sandbox `npm run dev:node` instead of wrangler.
LOCAL_TMF_BASE_URL=http://localhost:8787
# LOCAL_TMF_BASE_URL=https://telecom-api-sandbox.mustafaulu.workers.dev
CONTRACT_LOCK_FILE=./config/contracts.lock.json
CUSTOMER_ACCESS_ENABLED=false
# Real model turns (optional locally). Providers: google (default) or openai.
# MODEL_MODE=provider
# MODEL_PROVIDER=google
# MODEL_ID=gemini-3.5-flash-lite
# MODEL_API_KEY=...   # Google AI Studio / Gemini API key
MODEL_PROVIDER=
MODEL_ID=
MODEL_API_KEY=
# Live identity (AUTH_MODE=oidc). Cloudflare Access SaaS OIDC issuer example:
# https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client-id>
# Use the exact issuer from Access discovery. Allow only your email in Access + oidc-entitlements.yaml.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_STATE_SECRET=
OIDC_ENTITLEMENTS_FILE=./config/auth/oidc-entitlements.yaml
AUTHORIZATION_CONFIG_FILE=./config/auth/local-personas.yaml
# Defaults are implementation budgets, not measured SLOs.
TURN_DEADLINE_MS=60000
DISCOVERY_DEADLINE_MS=45000
MAX_DISCOVERY_STEPS=6
MAX_TOOL_CALLS=8
MAX_HTTP_ATTEMPTS=16
MAX_HTTP_CONCURRENCY=3
HTTP_ATTEMPT_TIMEOUT_MS=8000
FINAL_ANSWER_MAX_TOKENS=2000
CONVERSATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
# Never expose MODEL_API_KEY, OIDC secrets, or TMF credentials to the browser bundle.
# Vite client env must use only explicitly public VITE_* keys if any are introduced later.

